{
  "name": "@augen-auf/openmrs-esm-augen-auf",
  "version": "1.0.0",
  "description": "Augen Auf OpenMRS frontend module",
  "browser": "dist/openmrs-esm-augen-auf.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "start:azure": "openmrs develop --backend http://augen-auf-workshop.westeurope.cloudapp.azure.com",
