    "@openmrs/esm-framework": "*",
    "react": "18.x",
    "react-dom": "18.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "^5.0.0",
    "@swc/core": "^1.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27",
    "@types/react": "18.x",
    "@types/react-dom": "18.x",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^20.0.0",
    "jsdom": "^27.0.0",
    "openmrs": "^5.0.0",
    "react": "18.x",
    "react-dom": "18.x",
    "sass": "^1.93.2",
    "swc-loader": "^0.2.3",
    "typescript": "^4.9.5",
    "vitest": "^3.2.4",
    "webpack": "^5.88.0",
    "webpack-cli": "^4.10.0"
  },
  "packageManager": "yarn@4.10.3",
