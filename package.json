    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augen-auf/augen-auf-openmrs.git"
  },
  "license": "MIT",
